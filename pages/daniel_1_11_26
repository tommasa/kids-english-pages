<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>תרגול אוצר מילים באנגלית - כיתה ז'</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;700;800&family=Nunito:wght@600;800&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
  <style>
    :root {
      --primary: #4F46E5;
      --primary-hover: #4338CA;
      --accent: #F59E0B;
      --success: #10B981;
      --error: #EF4444;
      --bg: #F8FAFC;
      --card-bg: #FFFFFF;
      --text: #1E293B;
      --text-muted: #64748B;
      --border: #E2E8F0;
      --radius: 16px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Rubik', sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    header {
      background: white;
      border-bottom: 2px solid var(--border);
      padding: 1rem;
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .header-container {
      max-width: 900px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }

    .title-area h1 {
      font-size: 1.4rem;
      color: var(--primary);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .title-area span {
      font-size: 0.9rem;
      color: var(--text-muted);
      font-weight: normal;
    }

    .nav-tabs {
      display: flex;
      gap: 6px;
      background: #F1F5F9;
      padding: 4px;
      border-radius: 12px;
      overflow-x: auto;
      max-width: 100%;
    }

    .nav-tab {
      border: none;
      background: none;
      padding: 8px 14px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.9rem;
      cursor: pointer;
      color: var(--text-muted);
      white-space: nowrap;
      transition: all 0.2s;
    }

    .nav-tab.active {
      background: white;
      color: var(--primary);
      box-shadow: 0 2px 6px rgba(0,0,0,0.06);
    }

    main {
      flex: 1;
      max-width: 900px;
      width: 100%;
      margin: 0 auto;
      padding: 1.5rem 1rem;
    }

    .section-view {
      display: none;
    }

    .section-view.active {
      display: block;
      animation: fadeIn 0.3s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* כרטיסיות זיכרון */
    .flashcard-wrapper {
      perspective: 1000px;
      max-width: 480px;
      height: 320px;
      margin: 20px auto;
      cursor: pointer;
    }

    .flashcard-inner {
      position: relative;
      width: 100%;
      height: 100%;
      text-align: center;
      transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
      transform-style: preserve-3d;
      border-radius: var(--radius);
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
    }

    .flashcard-wrapper.flipped .flashcard-inner {
      transform: rotateY(180deg);
    }

    .flashcard-face {
      position: absolute;
      width: 100%;
      height: 100%;
      -webkit-backface-visibility: hidden;
      backface-visibility: hidden;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 2rem;
      border-radius: var(--radius);
      border: 2px solid var(--border);
      background: white;
    }

    .flashcard-back {
      transform: rotateY(180deg);
      background: #EEF2FF;
      border-color: #C7D2FE;
    }

    .en-word {
      font-family: 'Nunito', sans-serif;
      font-size: 2.2rem;
      font-weight: 800;
      color: var(--primary);
      direction: ltr;
      margin-bottom: 8px;
    }

    .he-word {
      font-size: 2rem;
      font-weight: 700;
      color: #1F2937;
      margin-bottom: 12px;
    }

    .sentence {
      font-size: 1rem;
      color: var(--text-muted);
      direction: ltr;
      margin-top: 10px;
      font-style: italic;
    }

    .card-footer-tip {
      position: absolute;
      bottom: 15px;
      font-size: 0.8rem;
      color: #94A3B8;
    }

    .controls-bar {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 12px;
      margin-top: 16px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 10px 20px;
      font-weight: 600;
      font-size: 0.95rem;
      border-radius: 12px;
      border: none;
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-primary { background: var(--primary); color: white; }
    .btn-primary:hover { background: var(--primary-hover); }
    .btn-outline { background: white; border: 1.5px solid var(--border); color: var(--text); }
    .btn-outline:hover { background: #F8FAFC; }
    .btn-icon { width: 44px; height: 44px; padding: 0; border-radius: 50%; font-size: 1.2rem; }

    /* מבחן אמריקאי */
    .quiz-container {
      max-width: 550px;
      margin: 0 auto;
      background: white;
      border: 1.5px solid var(--border);
      border-radius: var(--radius);
      padding: 1.8rem;
      box-shadow: 0 4px 15px rgba(0,0,0,0.04);
    }

    .quiz-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
      font-weight: 600;
      color: var(--text-muted);
    }

    .quiz-question {
      text-align: center;
      margin-bottom: 1.5rem;
    }

    .quiz-question .prompt-label {
      font-size: 0.9rem;
      color: var(--text-muted);
      margin-bottom: 6px;
    }

    .quiz-options {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .option-btn {
      padding: 14px;
      border: 1.5px solid var(--border);
      border-radius: 12px;
      background: white;
      font-size: 1.05rem;
      font-weight: 600;
      cursor: pointer;
      text-align: right;
      transition: all 0.2s;
    }

    .option-btn:hover:not(:disabled) {
      border-color: var(--primary);
      background: #F5F3FF;
    }

    .option-btn.correct {
      background: #DCFCE7 !important;
      border-color: var(--success) !important;
      color: #166534 !important;
    }

    .option-btn.wrong {
      background: #FEE2E2 !important;
      border-color: var(--error) !important;
      color: #991B1B !important;
    }

    /* משחק התאמה */
    .matching-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
      gap: 12px;
      max-width: 700px;
      margin: 20px auto;
    }

    .match-tile {
      background: white;
      border: 2px solid var(--border);
      padding: 18px 10px;
      border-radius: 12px;
      text-align: center;
      font-weight: 700;
      cursor: pointer;
      user-select: none;
      min-height: 80px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
    }

    .match-tile.selected {
      border-color: var(--primary);
      background: #EEF2FF;
      transform: scale(1.03);
    }

    .match-tile.matched {
      visibility: hidden;
      opacity: 0;
    }

    /* רשימת המילים */
    .search-box {
      width: 100%;
      padding: 12px 16px;
      border-radius: 12px;
      border: 1.5px solid var(--border);
      font-size: 1rem;
      margin-bottom: 1rem;
      outline: none;
    }

    .search-box:focus { border-color: var(--primary); }

    .word-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 12px;
    }

    .word-item {
      background: white;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .word-item .details .en {
      font-family: 'Nunito', sans-serif;
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--primary);
      direction: ltr;
      text-align: right;
    }

    .word-item .details .he {
      font-size: 0.95rem;
      color: var(--text-muted);
    }
  </style>
</head>
<body>

  <header>
    <div class="header-container">
      <div class="title-area">
        <h1>🎯 Unit 1: Teamwork <span>כיתה ז'</span></h1>
      </div>
      <div class="nav-tabs">
        <button class="nav-tab active" onclick="switchTab('cards')">🃏 כרטיסיות</button>
        <button class="nav-tab" onclick="switchTab('quiz')">✍️ מבחן</button>
        <button class="nav-tab" onclick="switchTab('match')">🧩 התאמה</button>
        <button class="nav-tab" onclick="switchTab('dict')">📖 מילון</button>
      </div>
    </div>
  </header>

  <main>
    <!-- כרטיסיות -->
    <section id="cards-view" class="section-view active">
      <div class="flashcard-wrapper" onclick="flipCard()">
        <div class="flashcard-inner" id="flashcard">
          <div class="flashcard-face flashcard-front">
            <span class="en-word" id="card-en">Science</span>
            <button class="btn btn-outline btn-icon" onclick="event.stopPropagation(); speakCurrentCard();">🔊</button>
            <div class="card-footer-tip">לחצי על הכרטיס כדי לראות את הפירוש ↺</div>
          </div>
          <div class="flashcard-face flashcard-back">
            <span class="he-word" id="card-he">מדע</span>
            <span class="sentence" id="card-sentence">We love learning about science in school.</span>
            <div class="card-footer-tip">לחצי כדי להפוך חזרה ↻</div>
          </div>
        </div>
      </div>
      <div class="controls-bar">
        <button class="btn btn-outline" onclick="prevCard()">הקודם ➔</button>
        <span id="card-counter" style="font-weight: 600; color: var(--text-muted);">1 / 38</span>
        <button class="btn btn-primary" onclick="nextCard()">למילה הבאה 🡠</button>
      </div>
    </section>

    <!-- מבחן אמריקאי -->
    <section id="quiz-view" class="section-view">
      <div class="quiz-container">
        <div class="quiz-top">
          <span id="quiz-streak">רצף: 0 🔥</span>
          <span id="quiz-score">ציון: 0</span>
        </div>
        <div class="quiz-question">
          <div class="prompt-label">מה התרגום הנכון של המילה:</div>
          <div class="en-word" id="quiz-en-word">Prefer</div>
          <button class="btn btn-outline btn-icon" style="margin-top:6px;" onclick="speakQuizWord()">🔊</button>
        </div>
        <div class="quiz-options" id="quiz-options"></div>
      </div>
    </section>

    <!-- משחק התאמה -->
    <section id="match-view" class="section-view">
      <div style="text-align: center; margin-bottom: 12px;">
        <span style="font-weight: 600; color: var(--text-muted);">התאימי כל מילה באנגלית לפירוש שלה בעברית</span>
      </div>
      <div class="matching-grid" id="match-grid"></div>
      <div style="text-align: center; margin-top: 16px;">
        <button class="btn btn-outline" onclick="initMatchGame()">ערבב מחדש 🔀</button>
      </div>
    </section>

    <!-- מילון -->
    <section id="dict-view" class="section-view">
      <input type="text" id="search-input" class="search-box" placeholder="חפשי מילה בעברית או באנגלית..." oninput="renderDictionary()">
      <div class="word-list" id="dictionary-list"></div>
    </section>
  </main>

  <script>
    const VOCAB = [
      { en: "Science", he: "מדע", sentence: "We do fun experiments in science class." },
      { en: "Salt", he: "מלח", sentence: "Please pass the salt for the soup." },
      { en: "List", he: "רשימה", sentence: "I made a shopping list before going to the store." },
      { en: "Team", he: "צוות / קבוצה", sentence: "Our football team won the final match." },
      { en: "Nation", he: "אומה / עם", sentence: "The entire nation celebrated the victory." },
      { en: "Variety", he: "מגוון", sentence: "The bakery has a variety of fresh breads." },
      { en: "Prefer", he: "להעדיף", sentence: "I prefer drinking water over soda." },
      { en: "Feed", he: "להאכיל", sentence: "Remember to feed the dog in the morning." },
      { en: "Serve", he: "להגיש / לשרת", sentence: "The waiter will serve lunch soon." },
      { en: "Fix", he: "לתקן", sentence: "Can you help me fix my broken bike?" },
      { en: "Follow", he: "לעקוב / לפעול לפי", sentence: "Please follow the teacher's instructions." },
      { en: "Imagine", he: "לדמיין", sentence: "Close your eyes and imagine you are on the beach." },
      { en: "Careful", he: "זהיר", sentence: "Be careful when crossing the busy road." },
      { en: "Wide", he: "רחב", sentence: "The river is very wide at this point." },
      { en: "Foreign", he: "זר / מחו\"ל", sentence: "It is exciting to learn a foreign language." },
      { en: "Usual", he: "רגיל", sentence: "I will meet you at the usual time." },
      { en: "According to", he: "לפי / על פי", sentence: "According to the weather forecast, it will rain." },
      { en: "Warm", he: "חמים / חם", sentence: "Put on a warm coat; it is cold outside." },
      { en: "Next to", he: "ליד / בסמוך ל", sentence: "She sat next to her best friend on the bus." },
      { en: "Possible", he: "אפשרי", sentence: "Is it possible to finish the project today?" },
      { en: "Dangerous", he: "מסוכן", sentence: "It is dangerous to swim alone in deep water." },
      { en: "Depend on", he: "להסתמך על / להיות תלוי ב", sentence: "Good friends depend on each other for help." },
      { en: "Lemon", he: "לימון", sentence: "She squeezed fresh lemon into the tea." },
      { en: "Theater", he: "תיאטרון", sentence: "We watched an exciting play at the theater." },
      { en: "Amazing", he: "מדהים", sentence: "The view from the top of the mountain is amazing." },
      { en: "Continue", he: "להמשיך", sentence: "Let's continue reading the story after the break." },
      { en: "Office", he: "משרד", sentence: "Her mother works in a big office building." },
      { en: "Would you like", he: "האם תרצה / תרצי?", sentence: "Would you like an apple or an orange?" },
      { en: "Choice", he: "בחירה", sentence: "You have a choice between apples or bananas." },
      { en: "Welcome", he: "ברוך הבא / לקבל בברכה", sentence: "We gave a warm welcome to the new student." },
      { en: "Shake hands", he: "ללחוץ ידיים", sentence: "It is polite to shake hands when you meet." },
      { en: "Receive", he: "לקבל", sentence: "I was very happy to receive your birthday card." },
      { en: "Help", he: "עזרה / לעזור", sentence: "Thank you so much for your kind help." },
      { en: "Village", he: "כפר", sentence: "My grandparents live in a quiet green village." },
      { en: "Journey", he: "מסע", sentence: "Traveling around the world is an unforgettable journey." },
      { en: "Bridge", he: "גשר", sentence: "We walked across the stone bridge over the river." },
      { en: "River", he: "נהר", sentence: "Boats sail up and down the long river." },
      { en: "Band", he: "להקה", sentence: "My brother plays the drums in a rock band." }
    ];

    let currentCardIndex = 0;
    let quizStreak = 0;
    let quizScore = 0;
    let currentQuizWord = null;

    // ניווט טאבים
    function switchTab(tabId) {
      document.querySelectorAll('.nav-tab').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.section-view').forEach(s => s.classList.remove('active'));
      
      const tabMap = { cards: 0, quiz: 1, match: 2, dict: 3 };
      document.querySelectorAll('.nav-tab')[tabMap[tabId]].classList.add('active');
      document.getElementById(`${tabId}-view`).classList.add('active');

      if (tabId === 'quiz') nextQuizQuestion();
      if (tabId === 'match') initMatchGame();
      if (tabId === 'dict') renderDictionary();
    }

    // הגיית קול באנגלית
    function speak(text) {
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = 'en-US';
        utterance.rate = 0.85;
        window.speechSynthesis.speak(utterance);
      }
    }

    // צלילים (Web Audio API)
    function playTone(freq, type = 'sine', duration = 0.15) {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, ctx.currentTime);
        gain.gain.setValueAtTime(0.1, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + duration);
      } catch(e) {}
    }

    // כרטיסיות
    function updateCard() {
      const card = VOCAB[currentCardIndex];
      document.getElementById('card-en').textContent = card.en;
      document.getElementById('card-he').textContent = card.he;
      document.getElementById('card-sentence').textContent = card.sentence;
      document.getElementById('card-counter').textContent = `${currentCardIndex + 1} / ${VOCAB.length}`;
      document.getElementById('flashcard').parentElement.classList.remove('flipped');
    }

    function flipCard() {
      document.getElementById('flashcard').parentElement.classList.toggle('flipped');
    }

    function nextCard() {
      currentCardIndex = (currentCardIndex + 1) % VOCAB.length;
      updateCard();
    }

    function prevCard() {
      currentCardIndex = (currentCardIndex - 1 + VOCAB.length) % VOCAB.length;
      updateCard();
    }

    function speakCurrentCard() {
      speak(VOCAB[currentCardIndex].en);
    }

    // מבחן
    function nextQuizQuestion() {
      currentQuizWord = VOCAB[Math.floor(Math.random() * VOCAB.length)];
      document.getElementById('quiz-en-word').textContent = currentQuizWord.en;
      
      const wrong = VOCAB.filter(w => w.en !== currentQuizWord.en)
                         .sort(() => 0.5 - Math.random())
                         .slice(0, 3);
      const options = [...wrong, currentQuizWord].sort(() => 0.5 - Math.random());

      const container = document.getElementById('quiz-options');
      container.innerHTML = '';
      options.forEach(opt => {
        const btn = document.createElement('button');
        btn.className = 'option-btn';
        btn.textContent = opt.he;
        
